# 草料二维码看板 — 环境变量示例
# 复制为 .env 或直接在部署平台（Railway 等）的环境变量中配置

# ===== 访问控制（P0）=====
# 访问令牌：访问看板 API 与页面需携带 ?token=本值 或请求头 x-api-token / Authorization: Bearer
# 生产环境务必修改为高强度随机串，不要用默认值
ACCESS_TOKEN=cli-dash-2026

# 可选 IP 白名单（逗号分隔），命中则免令牌。留空表示不启用
# ALLOWED_IPS=1.2.3.4,5.6.7.8

# ===== 查询缓存（P0）=====
# 统计类接口缓存秒数；0=关闭缓存；默认 60
CACHE_TTL=60

# ===== 数据库（已内置默认值，按需覆盖）=====
# DB_HOST=rm-bp1m4fy8d66u3c6xmbo.mysql.rds.aliyuncs.com
# DB_PORT=3306
