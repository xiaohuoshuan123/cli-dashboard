# 草料二维码看板 — 环境变量示例（占位符，非真实值）
# 复制为 .env 仅供本地调试；生产环境请在部署平台（Railway / Zeabur / Render / CloudBase 等）的后台配置。
#
# ⚠️ 重要：本文件中的 DB_PASSWORD / ACCESS_TOKEN 只是占位示例，不是当前生产值。
#    真实密钥请从「Railway 后台 → Variables」导出（仓库内无存储）。
#    详见 docs/部署到新平台-运行手册.md。

# ===== 访问控制（P0，必填，无兜底）=====
# 访问令牌：看板 API 与页面需携带 ?token=本值 或请求头 x-api-token / Authorization: Bearer
ACCESS_TOKEN=__从Railway导出的真实值__

# 可选 IP 白名单（逗号分隔），命中则免令牌。留空表示不启用
# ALLOWED_IPS=1.2.3.4,5.6.7.8

# ===== 查询缓存（P0）=====
# 统计类接口缓存秒数；0=关闭缓存；默认 60
CACHE_TTL=60

# ===== 数据库（必填 DB_PASSWORD；其余有默认值，按需覆盖）=====
# DB_HOST=rm-bp1m4fy8d66u3c6xmbo.mysql.rds.aliyuncs.com
# DB_PORT=3306
# DB_NAME=cli_44608921
# DB_USER=cli_44608921
# DB_PASSWORD=__从Railway导出的真实值__
